# LiveKit Cloud project URL (wss://...livekit.cloud)
LIVEKIT_URL=
# LiveKit API key from your project settings
LIVEKIT_API_KEY=
# LiveKit API secret from your project settings
LIVEKIT_API_SECRET=

# LiveKit SIP outbound trunk ID (created via `lk sip outbound create`)
LIVEKIT_SIP_TRUNK_ID=

# Twilio account SID from console.twilio.com
TWILIO_ACCOUNT_SID=
# Twilio auth token from console.twilio.com
TWILIO_AUTH_TOKEN=
# Twilio phone number used as caller ID for outbound PSTN calls (E.164)
TWILIO_PHONE_NUMBER=+19087728235

# Pretty Good AI test voice agent number to dial (E.164)
TARGET_NUMBER=+18054398008

# Deepgram API key for streaming STT
DEEPGRAM_API_KEY=

# ElevenLabs API key for streaming TTS
ELEVENLABS_API_KEY=
# ElevenLabs voice ID for the patient persona
ELEVENLABS_VOICE_ID=

# Baseten API key for hosting GLM 5.2 Fast
BASETEN_API_KEY=
# Baseten model endpoint URL (OpenAI-compatible base URL)
BASETEN_MODEL_URL=
# Baseten model name to pass in chat completions requests
BASETEN_MODEL_NAME=
